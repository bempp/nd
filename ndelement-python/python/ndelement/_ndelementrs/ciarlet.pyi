import numpy as np
import numpy.typing as npt

from .types import Continuity, LagrangeVariant, ReferenceCellType

class CiarletElement:
    def value_size(self) -> int: ...
    def value_shape(self) -> list[int]: ...
    def degree(self) -> int: ...
    def lagrange_superdegree(self) -> int: ...
    def dim(self) -> int: ...
    def continuity(self) -> Continuity: ...
    def cell_type(self) -> ReferenceCellType: ...
    def entity_dofs(self, entity_dim: int, entity_number: int) -> list[int]: ...
    def entity_closure_dofs(self, entity_dim: int, entity_number: int) -> list[int]: ...
    def physical_value_size(self, gdim: int) -> int: ...
    def physical_value_shape(self, gdim: int) -> list[int]: ...
    def tabulate_array_shape(self, nderivs: int, npoints: int) -> list[int]: ...
    def tabulate(
        self, points: npt.NDArray[np.float64], nderivs: int
    ) -> npt.NDArray[np.float64]: ...
    def interpolation_points(self) -> list[list[npt.NDArray[np.float64]]]: ...
    def interpolation_weights(self) -> list[list[npt.NDArray[np.float64]]]: ...
    def push_forward(
        self,
        reference_values: npt.NDArray[np.float64],
        nderivs: int,
        jacobians: npt.NDArray[np.float64],
        jacobian_determinants: npt.NDArray[np.float64],
        inverse_jacobians: npt.NDArray[np.float64],
    ) -> npt.NDArray[np.float64]: ...
    def pull_back(
        self,
        physical_values: npt.NDArray[np.float64],
        nderivs: int,
        jacobians: npt.NDArray[np.float64],
        jacobian_determinants: npt.NDArray[np.float64],
        inverse_jacobians: npt.NDArray[np.float64],
    ) -> npt.NDArray[np.float64]: ...
    def apply_dof_permutations_i64(self, data: npt.NDArray[np.int64], orientation: np.int32): ...
    def apply_dof_permutations_u64(self, data: npt.NDArray[np.uint64], orientation: np.int32): ...
    def apply_dof_permutations_f64(self, data: npt.NDArray[np.float64], orientation: np.int32): ...
    def apply_dof_transformations(self, data: npt.NDArray[np.float64], orientation: np.int32): ...
    def apply_dof_permutations_and_transformations(
        self, data: npt.NDArray[np.float64], orientation: np.int32
    ): ...

class ElementFamily:
    def element(self, cell: ReferenceCellType) -> CiarletElement: ...

def create_lagrange_family(
    degree: int, continuity: Continuity, variant: LagrangeVariant
) -> ElementFamily: ...
def create_raviart_thomas_family(degree: int, continuity: Continuity) -> ElementFamily: ...
def create_nedelec_family(degree: int, continuity: Continuity) -> ElementFamily: ...
